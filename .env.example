# Copy to .env and fill — never commit .env
# Required only if the problem needs external APIs (otherwise keep empty + use EVAL_MOCK=1)

# LLM (if needed)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Problem-specific (add at kickoff)
# API_BASE_URL=
# DATASET_URL=

# Feature flags
ENABLE_CACHE=1
ENABLE_VERIFY=1
LOG_LEVEL=info
PORT_BASELINE=8000
PORT_ADVANCED=8001

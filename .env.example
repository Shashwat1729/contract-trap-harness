# Copy to .env (repo root) and/or advanced/.env — never commit either.
# Nothing below is required to run this project: EVAL_MOCK=1 gives a full,
# deterministic, $0 reproduction with no API key at all (this is the default
# `make reproduce` path). Every flag below is OFF unless stated otherwise, so a
# judge running with no key sees the exact same certified numbers as the README.

# --- API Keys (all optional; free-tier) ---
# With a real GEMINI_API_KEY: LLM cross-check (llm_verify.py), the optional
# LLM-as-generator layer, and the LLM judge secondary metric all activate.
# Free-tier daily cap is small (~20 requests/day/project) -- keep any live test
# small (a handful of contracts), not a full sweep; see CHANGELOG #18/#22 for
# what happens honestly when that cap is hit (graceful degrade, not a crash).
OPENAI_API_KEY=sk-...           # optional, alternate provider for LLM verify
ANTHROPIC_API_KEY=sk-ant-...    # optional, alternate provider
GEMINI_API_KEY=...              # optional -- powers LLM verify + LLM-as-generator + LLM judge
LLM_MODEL=gemini/gemini-2.5-flash   # swap provider with one env change (litellm), no code change

# --- Core feature flags ---
ENABLE_CACHE=1
ENABLE_VERIFY=1
ENABLE_MEMORY=1
LOG_LEVEL=info
PORT=8001                      # baseline/src/config.py defaults to 8000, advanced/src/config.py defaults to 8001 -- override per-service only if you need different ports
HARNESS_MODE=auto              # auto | light | balanced | strict
MAX_CHARS=120000

# --- Real LLM cross-check (advanced/src/harness/llm_verify.py) ---
EVAL_MOCK=1                    # 1 = fully offline/deterministic (default here); 0 = real calls if a key is present
ENABLE_LLM_VERIFY=1
LLM_VERIFY_SKIP_CONFIDENCE=0.85   # skip the real call only when the deterministic gate already agreed AND confidence is this high (CHANGELOG #20)

# --- Additive extraction layers (all OFF by default -- opt-in, disclosed precision/recall trade-offs) ---
ENABLE_SEMANTIC_EXTRACTION=0   # real hosted-embedding layer, $ per call, n=7-validated (CHANGELOG #13)
ENABLE_BM25_EXTRACTION=0       # $0 lexical layer, validated on the full 510 real CUAD contracts (CHANGELOG #19)
ENABLE_LLM_EXTRACT=0           # LLM-as-generator: proposes candidates for playbook clause types with zero hits (CHANGELOG #22)
LLM_EXTRACT_MAX_CALLS=6        # hard cap on real calls per document for the layer above

# --- LangGraph agentic engine (advanced/src/harness/graph.py) ---
ENABLE_LANGGRAPH=0             # 0 = direct pipeline is the process-wide default; the dashboard/API can still opt a single call into "graph" engine regardless
ENABLE_GRAPH_INTERRUPT=0       # real human-in-the-loop pause on any REJECTed finding (CHANGELOG #21)
LANGGRAPH_CHECKPOINTER=memory  # memory | sqlite (sqlite persists a paused review across a process restart)
LANGSMITH_TRACING=0

# --- Resilience / API hardening (env-tunable) ---
LLM_TIMEOUT=30
REDLINE_TIMEOUT_S=30           # per-request budget for POST /api/redline (504 + fallback payload when exceeded)
# CORS_ORIGINS=https://app.example.com   # comma-separated; default "*" (credentials are never allowed)
# MAX_NEGOTIATION_MEMORIES=1000          # LRU bound on the in-memory per-contract negotiation memory
# UVICORN_RELOAD=0                       # 1 = dev auto-reload when running `python -m src.main`

# --- Developer-view thinking logs (advanced/evidence/reviews/) ---
THINKING_SNAPSHOT=1            # one aggregated snapshot per contract/turn (thinking_<id>_t<turn>.json)
THINKING_LOG_PERSIST=0         # 1 = also rewrite per-module thinking_<module>.json on every log line (slow; debugging only)
RETRY_MAX_WAIT=4
RETRY_MAX_ATTEMPTS=3

# --- Eval sample sizes (small by design for free-tier quota; deterministic evals like
#     eval_cuad_ground_truth.py ignore these and always run the full 510 contracts) ---
EVAL_SAMPLE_CUAD=30
EVAL_SAMPLE_REDLINE=20
EVAL_SAMPLE_TRAPS=30

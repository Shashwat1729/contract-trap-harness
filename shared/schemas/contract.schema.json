{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Contract",
  "type": "object",
  "required": ["contract_id", "contract_text", "party", "turn"],
  "properties": {
    "contract_id": {"type": "string", "minLength": 1},
    "contract_text": {"type": "string", "minLength": 1},
    "party": {"type": "string", "enum": ["AgentCo", "LargeCo", "GiantCo"]},
    "turn": {"type": "integer", "minimum": 1, "maximum": 4},
    "grounding": {
      "type": "object",
      "properties": {
        "playbook": {"type": "string"},
        "commercial_context": {"type": "string"},
        "prior_docx": {"type": "string"}
      }
    }
  },
  "description": "Harbor-like contract input: contract.docx text + grounding materials"
}

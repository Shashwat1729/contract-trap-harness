{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "RedlineFinding",
  "type": "object",
  "required": ["trap_id", "clause_type", "risk", "span_text", "page", "line", "proposed_change", "evidence", "verification"],
  "properties": {
    "trap_id": {"type": "string"},
    "clause_type": {"type": "string"},
    "risk": {"type": "string", "enum": ["High", "Medium", "Low"]},
    "span_text": {"type": "string"},
    "page": {"type": "integer", "minimum": 1},
    "line": {"type": "integer", "minimum": 1},
    "proposed_change": {"type": "string"},
    "rationale": {"type": "string"},
    "rule_id": {"type": "string"},
    "precedent_id": {"type": "string"},
    "evidence": {
      "type": "object",
      "required": ["contract_span", "contract_page", "playbook_rule"],
      "properties": {
        "contract_span": {"type": "string"},
        "contract_page": {"type": "integer"},
        "playbook_rule": {"type": "string"},
        "precedent": {"type": ["object", "null"]}
      }
    },
    "verification": {"type": "string", "enum": ["PASS", "REJECT"]},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "route": {"type": "string", "enum": ["auto", "human_review"]},
    "surgical": {"type": "boolean"}
  }
}
